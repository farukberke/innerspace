# Copy this file to `.env` and fill in values locally.
# `.env` is git-ignored. NEVER commit real secrets.
# Variables are added here only when the code actually uses them.

APP_ENV=development
LOG_LEVEL=INFO

# Local PostgreSQL (docker compose). Choose your own local password.
POSTGRES_USER=innerspace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=innerspace
POSTGRES_PORT=5433
# Must match the values above. Tests use the same server with the `<db>_test` database.
DATABASE_URL=postgresql+asyncpg://innerspace:change-me@localhost:5433/innerspace


# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7                # refresh tokens rotate on every use
# SESSION_MAX_DAYS=30                 # absolute session length from login; refresh never extends it
# INVITATION_HOURS=72

# Demo seed password for all seeded users (optional; random and printed if unset).
# SEED_PASSWORD=
# Production demo only: SEED_DEMO=1 lets `python -m app.seed` run with APP_ENV=production
# (requires SEED_PASSWORD, 12+ chars). Synthetic data only; unset again afterwards.
# SEED_DEMO=

# AI (Pydantic AI). Without ANTHROPIC_API_KEY the AI endpoints return 503.
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# LLM_MAX_RETRIES=2
# LLM_TIMEOUT_SECONDS=60
# LLM_INPUT_USD_PER_MTOK=3.0
# LLM_OUTPUT_USD_PER_MTOK=15.0

# Background jobs (Celery + Redis). Run a worker: `celery -A app.worker worker` from backend/,
# or run the whole stack with `docker compose up --build` (api on :8000 + worker).
REDIS_PORT=6380
CELERY_BROKER_URL=redis://localhost:6380/0
# JOB_MAX_RETRIES=3
# JOB_RETRY_BACKOFF_SECONDS=10

# Reverse proxies in front of the app (Render: 1). 0 = ignore X-Forwarded-For (local dev).
# N > 0: client IP = Nth entry from the right of X-Forwarded-For (never trust more hops than you run).
# TRUSTED_PROXY_HOPS=0               # REQUIRED (explicit) when APP_ENV=production

# Rate limiting (Redis-backed; format "<count>/<n><second|minute|hour|day>"). Defaults shown.
# RATE_LIMIT_BACKEND=redis            # "memory" = single process only (dev/tests)
# RATE_LIMIT_REDIS_URL=               # default: CELERY_BROKER_URL
# RATE_LIMIT_LOGIN_IP=30/minute
# RATE_LIMIT_LOGIN_EMAIL=8/15minute
# RATE_LIMIT_REFRESH=30/minute
# RATE_LIMIT_LOGOUT=30/minute
# RATE_LIMIT_ACCEPT_INVITATION=10/minute
# RATE_LIMIT_GENERATE=10/hour
# RATE_LIMIT_AFTER_SESSION=30/hour
# Per-user rolling 24h LLM budget (0 = no cap).
# LLM_DAILY_REQUEST_LIMIT=200
# LLM_DAILY_COST_LIMIT_USD=2.0

# Observability. LLM tracing (Logfire) is off without a token and never sends content.
# LOGFIRE_TOKEN=
# /metrics (Prometheus) is 404 unless a token is set; send it as `Authorization: Bearer <token>`.
# METRICS_TOKEN=

# Stale job reaper and DB pool.
# JOB_STALE_AFTER_SECONDS=900
# JOB_REAPER_INTERVAL_SECONDS=60
# REFRESH_PURGE_INTERVAL_SECONDS=3600   # beat: delete expired refresh tokens
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800

# CORS: comma-separated frontend origins (empty = off, wildcard rejected). Dev: http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
